# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

*.tsbuildinfo
!.env.example

.secrets/
.mcpregistry*
__pycache__/
/.openai/
.dev.vars*
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
/public/source/*.tar
/public/source/checksum.json
/wrangler.jsonc

# Private keys and operational artifacts; migration source stays visible.
*.key
.secrets
/backup/
/backups/
/exports/
/backup*.sql
/dump*.sql
/export*.sql
/prod*.sql
*.sql.gz
*.sql.bak
*.sql.backup
*.db.bak
*.sqlite.bak
*.sqlite3.bak
*.dump
*.dump.*

# Production Wrangler variants, with the reviewed local configuration retained.
/wrangler*.json
/wrangler*.jsonc
/wrangler*.toml
!/wrangler.local.jsonc

# IndexNow configuration and verification artifacts never belong in Git.
/scripts/registry/indexnow*.json
/public/indexnow/
/public/indexnow*.txt
/public/.well-known/indexnow/
/public/[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*.txt
