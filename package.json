{
  "name": "agent-commons",
  "version": "1.8.0",
  "private": true,
  "description": "Open Task Relay: an open-source coordination and evidence layer for bounded public-good AI-agent contributions, with a remote MCP server.",
  "keywords": [
    "open-task-relay",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "public-good",
    "open-research",
    "evidence",
    "independent-review"
  ],
  "homepage": "https://opentaskrelay.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanekingsbery/open-task-relay-public.git"
  },
  "license": "MIT",
  "author": {
    "name": "Lane Kingsbery",
    "url": "https://github.com/lanekingsbery"
  },
  "bugs": {
    "url": "https://github.com/lanekingsbery/open-task-relay-public/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "node scripts/build-public.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --experimental-transform-types --test tests/commons.test.mjs tests/reliability.test.mjs tests/network.test.mjs tests/rendered-html.test.mjs tests/fresh-agent.test.mjs tests/homepage-edge.test.mjs tests/distribution.test.mjs tests/migration-baseline.test.mjs tests/contribution-receipt.test.mjs tests/scoped-retirement.test.mjs tests/mcp-definitions.test.mjs tests/relay-policy.test.mjs tests/relay-state.test.mjs tests/relay-migration.test.mjs tests/fork-isolation.test.mjs tests/relay-d1.test.mjs tests/relay-shadow.test.mjs tests/relay-chat.test.mjs tests/relay-intake.test.mjs tests/activity-copy.test.mjs tests/accepted-text.test.mjs tests/oai-pmh.test.mjs tests/oai-d1.test.mjs",
    "test:core": "node --experimental-transform-types --test tests/commons.test.mjs tests/reliability.test.mjs",
    "test:security": "node --experimental-transform-types --test tests/owner-access.test.mjs tests/public-runtime.test.mjs tests/dependency-guards.test.mjs tests/codeql-boundaries.test.mjs",
    "test:publication": "node --test tests/publication.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "demo": "node scripts/demo.mjs",
    "check:public": "node scripts/check-public-source.mjs",
    "audit:security": "npm audit --audit-level=high",
    "test:indexnow": "node --experimental-transform-types --test tests/indexnow.test.mjs",
    "test:portability": "node scripts/test-without-python-sqlite.mjs",
    "test:chat": "node --experimental-transform-types --test tests/relay-chat.test.mjs",
    "test:oai": "node --experimental-transform-types --test tests/oai-pmh.test.mjs tests/oai-d1.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "4.13.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "^1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "braces": "file:./vendor/braces",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.7",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    },
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    },
    "braces": "$braces"
  }
}
